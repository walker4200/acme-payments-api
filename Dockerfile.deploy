# Used ONLY for the public Render deployment (DAST target).
# Runs on a PATCHED Node.js (Oct 21 2026 security release: 24.22.1) so the live host isn't exposed
# to runtime CVEs. The intentionally-EOL image for container scanning is ./Dockerfile (node:16).
FROM node:24.22.1-bookworm-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY . .
ENV NODE_ENV=production
USER node
EXPOSE 3000
CMD ["node", "src/server.js"]
